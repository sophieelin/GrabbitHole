# Copy this file to .env and fill in what you need. Never commit .env.
# Everything here is optional on your own machine.

# The database. Unset on your own machine, the server keeps records in an in-memory MongoDB
# and loses them when it stops. On the deployed app, add MongoDB on the site under
# "Databases and storage" with this exact variable name; the connection string is filled in for you.
# MONGODB_URI=mongodb://dev:dev@127.0.0.1:27017/grabbithole?authSource=admin

# The address people open in the browser. Unset, it is http://localhost:<PORT>.
# On the deployed app, set it to https://<name>.mit-sdg.dev, or sign-in requests are refused.
# PUBLIC_ORIGIN=https://<name>.mit-sdg.dev
